rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Students collection
    // Single-document read allowed for public student links (no login required for students)
    // Only authenticated teachers can list or delete students
    // Creation and update allowed for authenticated teachers or securely generated student IDs
    match /students/{studentId} {
      allow get: if isValidId(studentId);
      allow list: if isTeacher();
      allow create, update: if (isTeacher() || studentId.matches('^(stu_|test_|sample-)[a-zA-Z0-9_-]+$'))
        && isValidId(studentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
      allow delete: if isTeacher() && isValidId(studentId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isTeacher() && isValidId(settingId);
    }
  }
}
